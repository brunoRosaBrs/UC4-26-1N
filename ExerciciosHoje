export class Product {
    private name: string;
    private price: number;
    private stock: number;

    public constructor(name: string, price: number, stock: number) {
        this.name = name;
        this.price = price;
        this.stock = stock;
    }

    // Getters
    public getName(): string {
        return this.name;
    }

    public getPrice(): number {
        return this.price;
    }

    public getStock(): number {
        return this.stock;
    }

    // Setters
    public setName(newName: string): void {
        this.name = newName;
    }

    public setPrice(newPrice: number): void {
        if (newPrice >= 0) {
            this.price = newPrice;
        }
    }

    // Métodos
    public addStock(quantity: number): void {
        if (quantity > 0) {
            this.stock = this.stock + quantity;
            console.log(`${quantity} products added to stock.`);
        } else {
            console.log("The quantity must be greater than zero.");
        }
    }

    public removeStock(quantity: number): void {
        if (quantity > this.stock) {
            console.log("There is not enough stock.");
        } else if (quantity <= 0) {
            console.log("The quantity must be greater than zero.");
        } else {
            this.stock = this.stock - quantity;
            console.log(`${quantity} products removed from stock.`);
        }
    }

    public showProduct(): void {
        console.log(`Product: ${this.name}`);
        console.log(`Price: R$ ${this.price}`);
        console.log(`Stock: ${this.stock}`);
    }
}


