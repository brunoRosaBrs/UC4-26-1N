// EXERCICIO 2
export class Car{
    private brand: string
    private model:string
    private year: number
    private speed: number

    public constructor(brand: string, model: string, year: number) {
        this.brand = brand;
        this.model = model;
        this.year = year;
        this.speed = 0;
    }

    //Getter
    public getBrand(): string{
        return this.brand
    };
    public getModel(): string{
        return this.model
    };
    public getYear(): number{
        return this.year
    };
    public getSpeed(): number{
        return this.speed
    };

    //Setter
    public setBrand(newBrand: string): void {
        this.brand = newBrand;
    }
    public setModel(newModel: string): void{
        this.model = newModel;
    }
    public setYear(newYear: number): void{
        this.year = newYear;
    }

    //MÉTODOS
    public accelerate(value: number): void {
        if (value > 0){
        this.speed = this.speed + value;
    }
    }

    public brake(value: number): void {
        this.speed = this.speed - value;
        if (this.speed < 0) {
            this.speed = 0;
        }
    }

    public showInformation(): void {
        console.log(`Car: ${this.brand} ${this.model} (${this.year}) > Speed: ${this.speed} km/h`);
    }
}
        
