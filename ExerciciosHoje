export class Movie {
    private title: string;
    private duration: number;
    private rating: number;

    public constructor(
        title: string,
        duration: number,
        rating: number
    ) {
        this.title = title;
        this.duration = duration;
        this.rating = rating;
    }

    // Getters
    public getTitle(): string {
        return this.title;
    }

    public getDuration(): number {
        return this.duration;
    }

    public getRating(): number {
        return this.rating;
    }

    // Setters
    public setTitle(newTitle: string): void {
        this.title = newTitle;
    }

    public setDuration(newDuration: number): void {
        if (newDuration > 0) {
            this.duration = newDuration;
        }
    }

    public setRating(newRating: number): void {
        if (newRating >= 0 && newRating <= 10) {
            this.rating = newRating;
        }
    }

    // Métodos
    public changeRating(newRating: number): void {
        if (newRating >= 0 && newRating <= 10) {
            this.rating = newRating;

            console.log(
                `The rating of "${this.title}" was changed.`
            );
        } else {
            console.log(
                "The rating must be between 0 and 10."
            );
        }
    }

    public showMovie(): void {
        console.log(`Title: ${this.title}`);
        console.log(`Duration: ${this.duration} minutes`);
        console.log(`Rating: ${this.rating}`);
    }
}



