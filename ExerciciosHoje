export class Smartphone {
    private brand: string;
    private model: string;
    private battery: number;

    public constructor(brand: string, model: string) {
        this.brand = brand;
        this.model = model;
        this.battery = 100;
    }

    // Getters
    public getBrand(): string {
        return this.brand;
    }

    public getModel(): string {
        return this.model;
    }

    public getBattery(): number {
        return this.battery;
    }

    // Setters
    public setBrand(newBrand: string): void {
        this.brand = newBrand;
    }

    public setModel(newModel: string): void {
        this.model = newModel;
    }

    // Métodos
    public use(minutes: number): void {
        if (minutes > 0) {
            this.battery = this.battery - minutes;

            if (this.battery < 0) {
                this.battery = 0;
            }

            console.log(
                `The smartphone was used for ${minutes} minutes.`
            );
        } else {
            console.log(
                "The number of minutes must be greater than zero."
            );
        }
    }

    public charge(): void {
        this.battery = 100;

        console.log(
            "The smartphone is fully charged."
        );
    }

    public showInformation(): void {
        console.log(`Brand: ${this.brand}`);
        console.log(`Model: ${this.model}`);
        console.log(`Battery: ${this.battery}%`);
    }
}



