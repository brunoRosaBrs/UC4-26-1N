//EXERCICIO 5
export class Book {
    private title: string;
    private author: string;
    private pages: number;
    private available: boolean;

    public constructor(
        title: string,
        author: string,
        pages: number,
        available: boolean
    ) {
        this.title = title;
        this.author = author;
        this.pages = pages;
        this.available = available;
    }

    // Getters
    public getTitle(): string {
        return this.title;
    }

    public getAuthor(): string {
        return this.author;
    }

    public getPages(): number {
        return this.pages;
    }

    public getAvailable(): boolean {
        return this.available;
    }

    // Setters
    public setTitle(newTitle: string): void {
        this.title = newTitle;
    }

    public setAuthor(newAuthor: string): void {
        this.author = newAuthor;
    }

    public setPages(newPages: number): void {
        this.pages = newPages;
    }

    // Métodos
    public borrow(): void {
        if (this.available === true) {
            this.available = false;
            console.log(`The book "${this.title}" was borrowed.`);
        } else {
            console.log(`The book "${this.title}" is not available.`);
        }
    }

    public returnBook(): void {
        if (this.available === false) {
            this.available = true;
            console.log(`The book "${this.title}" was returned.`);
        } else {
            console.log(`The book "${this.title}" is already available.`);
        }
    }

    public showInformation(): void {
        console.log(`Title: ${this.title}`);
        console.log(`Author: ${this.author}`);
        console.log(`Pages: ${this.pages}`);
        console.log(`Available: ${this.available}`);
    }
}


