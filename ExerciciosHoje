export class Employee {
    private name: string;
    private salary: number;

    public constructor(name: string, salary: number) {
        this.name = name;
        this.salary = salary;
    }

    // Getters
    public getName(): string {
        return this.name;
    }

    public getSalary(): number {
        return this.salary;
    }

    // Setters
    public setName(newName: string): void {
        this.name = newName;
    }

    public setSalary(newSalary: number): void {
        if (newSalary >= 0) {
            this.salary = newSalary;
        }
    }

    // Métodos
    public increaseSalary(percent: number): void {
        if (percent > 0) {
            const increase = this.salary * (percent / 100);

            this.salary = this.salary + increase;

            console.log(
                `Salary increased by ${percent}%.`
            );
        } else {
            console.log(
                "The percentage must be greater than zero."
            );
        }
    }

    public showInformation(): void {
        console.log(`Name: ${this.name}`);
        console.log(`Salary: R$ ${this.salary}`);
    }
}


