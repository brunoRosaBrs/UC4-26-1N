export class LibraryMember {
    private name: string;
    private borrowedBooks: number;

    public constructor(name: string) {
        this.name = name;
        this.borrowedBooks = 0;
    }

    // Getters
    public getName(): string {
        return this.name;
    }

    public getBorrowedBooks(): number {
        return this.borrowedBooks;
    }

    // Setter
    public setName(newName: string): void {
        this.name = newName;
    }

    // Métodos
    public borrowBook(): void {
        if (this.borrowedBooks < 3) {
            this.borrowedBooks = this.borrowedBooks + 1;

            console.log(
                `${this.name} borrowed a book.`
            );
        } else {
            console.log(
                `${this.name} cannot borrow more books. Maximum limit is 3.`
            );
        }
    }

    public returnBook(): void {
        if (this.borrowedBooks > 0) {
            this.borrowedBooks = this.borrowedBooks - 1;

            console.log(
                `${this.name} returned a book.`
            );
        } else {
            console.log(
                `${this.name} has no books to return.`
            );
        }
    }

    public showInformation(): void {
        console.log(`Name: ${this.name}`);
        console.log(
            `Borrowed books: ${this.borrowedBooks}`
        );
    }
}






















