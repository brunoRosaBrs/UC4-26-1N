//EXERCICIO 3:
export class BankAccount {
    private owner: string;
    private balance: number;

    public constructor(owner: string, balance: number) {
        this.owner = owner;
        this.balance = balance;
    }

    // Getters
    public getOwner(): string {
        return this.owner;
    }

    public getBalance(): number {
        return this.balance;
    }

    // Setters
    public setOwner(newOwner: string): void {
        this.owner = newOwner;
    }

    // Métodos
    public deposit(value: number): void {
        if (value > 0) {
            this.balance = this.balance + value;
            console.log(`Deposit of R$ ${value} made successfully.`);
        } else {
            console.log("The deposit must be greater than zero.");
        }
    }

    public withdraw(value: number): void {
        if (value > this.balance) {
            console.log("Insufficient balance.");
        } else if (value <= 0) {
            console.log("The withdrawal must be greater than zero.");
        } else {
            this.balance = this.balance - value;
            console.log(`Withdrawal of R$ ${value} made successfully.`);
        }
    }

    public showBalance(): void {
        console.log(`Owner: ${this.owner}`);
        console.log(`Balance: R$ ${this.balance}`);
    }
}


